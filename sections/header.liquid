<header class="sticky top-0 z-50 bg-[#fff8f5] bg-opacity-90 backdrop-blur-xl border-b border-[#dfc0b7]/30">
  <nav class="flex justify-between items-center w-full px-8 py-4 max-w-screen-2xl mx-auto">
    <div class="flex items-center gap-12">
      <a href="{{ routes.root_url }}" class="text-2xl font-bold font-headline text-[#28180d] tracking-tight">
        {{ shop.name }}
      </a>
      
      <div class="hidden md:flex gap-8 text-sm">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" class="text-[#28180d]/80 font-bold hover:text-[#39614e] transition-colors {% if link.active %}text-[#39614e] border-b-2 border-[#39614e] pb-1{% endif %}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    </div>
    
    <div class="flex items-center gap-6">
      <form action="{{ routes.search_url }}" method="get" class="relative hidden lg:block">
        <input type="text" name="q" placeholder="Search heritage grains..." class="bg-[#fff1ea] border-none rounded-full py-2 pl-10 pr-4 w-64 focus:ring-2 focus:ring-[#39614e] text-sm font-body">
        <span class="material-symbols-outlined absolute left-3 top-2 text-[#58423b] text-xl">search</span>
      </form>
      
      <div class="flex gap-4">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="scale-95 active:opacity-80 transition-all text-[#39614e]">
            <span class="material-symbols-outlined">person</span>
          </a>
        {% endif %}
        
        <a href="{{ routes.cart_url }}" class="scale-95 active:opacity-80 transition-all text-[#39614e] relative">
          <span class="material-symbols-outlined">shopping_bag</span>
          {% if cart.item_count > 0 %}
            <span class="absolute -top-1 -right-1 bg-[#973d00] text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>
      </div>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}