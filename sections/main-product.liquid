<section class="max-w-screen-2xl mx-auto px-8 py-16 font-body">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
    
    <!-- Left Column: Image Gallery -->
    <div class="space-y-6">
      <!-- Main Featured Image -->
      <div class="aspect-[4/5] rounded-3xl overflow-hidden bg-[#fff1ea] shadow-sm">
        <img 
          src="{{ product.featured_image | image_url: width: 1000 }}" 
          alt="{{ product.title | escape }}" 
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          class="w-full h-full object-cover"
        >
      </div>
      
      <!-- Thumbnail Images Loop -->
      {% if product.images.size > 1 %}
        <div class="grid grid-cols-4 gap-4">
          {% for image in product.images offset: 1 %}
            <div class="aspect-square rounded-xl overflow-hidden bg-[#fff1ea] cursor-pointer hover:opacity-80 transition-opacity">
              <img 
                src="{{ image | image_url: width: 300 }}" 
                alt="{{ product.title | escape }} thumbnail" 
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
                class="w-full h-full object-cover"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Information & Form -->
    <div class="flex flex-col pt-4 md:pt-10">
      
      <!-- Tags / Breadcrumbs -->
      {% if product.tags.size > 0 %}
        <div class="flex gap-2 mb-4">
          {% for tag in product.tags %}
            <span class="bg-[#fff1ea] text-[#973d00] text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full font-headline">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <h1 class="font-headline font-black text-4xl md:text-5xl text-[#28180d] mb-4 leading-tight">
        {{ product.title }}
      </h1>
      
      <div class="font-headline font-bold text-3xl text-[#973d00] mb-8">
        {{ product.price | money }}
      </div>

      <!-- Native Shopify Description (Rendered as HTML) -->
      <div class="prose prose-lg text-[#58423b] mb-12 leading-relaxed">
        {{ product.description }}
      </div>

      <!-- Add to Cart Form -->
      {% form 'product', product, class: 'mt-auto' %}
        
        <!-- Variant Selectors (Only shows if the product has multiple options like Size or Flavor) -->
        {% unless product.has_only_default_variant %}
          <div class="mb-8 space-y-6">
            {% for option in product.options_with_values %}
              <div>
                <label class="block font-bold text-xs uppercase tracking-widest text-[#28180d] mb-3">
                  {{ option.name }}
                </label>
                <select name="options[{{ option.name | escape }}]" class="w-full bg-[#fff1ea] border-none rounded-xl px-5 py-4 focus:ring-2 focus:ring-[#39614e] font-bold text-[#58423b] appearance-none">
                  {% for value in option.values %}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>
                      {{ value }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <!-- Hidden input required by Shopify to track which variant is added -->
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">

        <!-- Quantity & Submit -->
        <div class="flex gap-4">
          <div class="relative w-32 shrink-0">
            <label class="sr-only">Quantity</label>
            <input 
              type="number" 
              name="quantity" 
              value="1" 
              min="1" 
              class="w-full h-full bg-[#fff1ea] border-none rounded-xl px-4 py-4 text-center font-bold focus:ring-2 focus:ring-[#39614e] text-lg"
            >
          </div>
          
          <button 
            type="submit" 
            class="flex-1 bg-[#39614e] text-white py-5 rounded-xl font-headline font-bold flex items-center justify-center gap-3 hover:bg-[#274e3d] transition-all shadow-md active:scale-[0.98] text-lg disabled:opacity-50"
            {% unless product.available %}disabled{% endunless %}
          >
            {% if product.available %}
              <span class="material-symbols-outlined text-2xl">shopping_basket</span>
              Add to Cart
            {% else %}
              Out of Stock
            {% endif %}
          </button>
        </div>
      {% endform %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "settings": []
}
{% endschema %}