<section class="max-w-screen-2xl mx-auto px-8 py-12">
  <header class="flex justify-between items-end mb-10">
    <div>
      <h1 class="font-headline font-black text-5xl tracking-tight mb-2">{{ collection.title }}</h1>
      <p class="text-on-surface-variant font-medium">{{ collection.description | strip_html }}</p>
    </div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10">
    {% for product in collection.products %}
      <article class="group relative">
        <a href="{{ product.url }}" class="block">
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-[#fff1ea] mb-4">
            <img 
              src="{{ product.featured_image | image_url: width: 600 }}" 
              alt="{{ product.title | escape }}" 
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            >
            
            {% if product.tags contains 'Heritage' %}
              <div class="absolute top-4 left-4">
                <span class="bg-[#39614e] text-white text-[10px] font-black uppercase tracking-tighter px-2 py-1 rounded">Heritage</span>
              </div>
            {% endif %}
          </div>
          
          <div class="px-1">
            <div class="flex justify-between items-start mb-1">
              <h3 class="font-bold text-[#28180d] group-hover:text-[#39614e] transition-colors">{{ product.title }}</h3>
              <span class="font-headline font-bold text-[#973d00]">{{ product.price | money }}</span>
            </div>
          </div>
        </a>
        
        <form method="post" action="{{ routes.cart_add_url }}" class="mt-4">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
          <button type="submit" class="w-full bg-[#39614e] text-white py-3 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-[#274e3d] transition-colors shadow-sm active:scale-95">
            <span class="material-symbols-outlined text-xl">shopping_cart</span>
            Add to Cart
          </button>
        </form>
      </article>
    {% else %}
      <p>No products found in this collection.</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": []
}
{% endschema %}