<footer class="bg-[#fff8f5] border-t border-[#dfc0b7]/30 pt-16 pb-8 font-body text-[#28180d]">
  <div class="max-w-screen-2xl mx-auto px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      {% for block in section.blocks %}
        {% case block.type %}
          
          {% when 'link_list' %}
            <div class="space-y-6" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="font-headline font-bold text-lg text-[#28180d]">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.menu != blank %}
                <ul class="flex flex-col gap-3 text-sm">
                  {% for link in linklists[block.settings.menu].links %}
                    <li>
                      <a href="{{ link.url }}" class="text-[#58423b] hover:text-[#39614e] underline decoration-2 underline-offset-4 transition-all">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>

          {% when 'text' %}
            <div class="space-y-4" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="font-headline font-bold text-lg text-[#28180d]">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              <div class="text-[#58423b] text-sm leading-relaxed">
                {{ block.settings.subtext }}
              </div>
            </div>

          {% when 'newsletter' %}
            <div class="space-y-4 lg:col-span-2" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="font-headline font-bold text-lg text-[#28180d]">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              <div class="text-[#58423b] text-sm mb-4">
                {{ block.settings.text }}
              </div>
              
              {% form 'customer', class: 'newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="flex gap-2 max-w-md">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="bg-[#fff1ea] border-none rounded-xl px-4 py-3 flex-1 text-sm focus:ring-2 focus:ring-[#39614e] placeholder:text-[#58423b]/50"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="Email Address"
                    required
                  >
                  <button type="submit" class="bg-[#39614e] text-white w-12 h-12 rounded-xl flex items-center justify-center hover:bg-[#274e3d] transition-colors active:scale-95 shrink-0" name="commit" id="Subscribe">
                    <span class="material-symbols-outlined">send</span>
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="text-[#973d00] text-xs mt-2 block flex items-center gap-1" id="Newsletter-error--{{ section.id }}">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                  </small>
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                  <h3 class="text-[#39614e] text-xs mt-2 font-bold flex items-center gap-1" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    Thanks for subscribing!
                  </h3>
                {%- endif -%}
              {% endform %}
            </div>
            
        {% endcase %}
      {% endfor %}
    </div>

    <div class="border-t border-[#dfc0b7]/30 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-[#58423b]">
      <div class="flex flex-col md:flex-row gap-2 md:gap-6 items-center">
        <p>&copy; {{ 'now' | date: "%Y" }} <a href="{{ routes.root_url }}" class="hover:text-[#39614e] font-bold transition-colors">{{ shop.name }}</a>. All rights reserved.</p>
        <p>Curated Heritage Grains & Spices</p>
      </div>
      
      {%- if section.settings.payment_enable -%}
        <div class="flex gap-2 opacity-60 hover:opacity-100 transition-opacity">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'h-6' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show payment icons"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "The Newsletter",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Heritage recipes and stories from our farmers, once a month.</p>",
          "label": "Subtext"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "link_list"
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}